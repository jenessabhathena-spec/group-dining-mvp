# Copy to deploy/.env and fill in. Never commit the real .env.
# Check it before deploying:  node --env-file=deploy/.env scripts/check-config.mjs

# Your domain (DNS A record pointing at the server). Caddy gets the HTTPS certificate for it.
DOMAIN=plans.example.in
# The same address with https://, used in WhatsApp links. No trailing slash.
PUBLIC_URL=https://plans.example.in

# Sign-in codes and reminders (see README "SMS setup"). Needs DLT-approved templates.
SMS_PROVIDER=msg91
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_REMINDER_TEMPLATE_ID=
MSG91_REMINDER_SURPRISE_TEMPLATE_ID=
MSG91_RATE_TEMPLATE_ID=
# Ceiling on sign-in codes per day for the whole service (stops SMS-pumping bills).
OTP_DAILY_CAP=300

# Google Maps Platform key with Distance Matrix and Places API (New) enabled.
# Restrict it to this server's IP address and to those two APIs only.
GOOGLE_MAPS_API_KEY=

# Admin endpoints (metrics, plan logs, reports, weights). At least 24 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Leave empty to switch admin off.
ADMIN_KEY=

# Retention and backups
EVENT_RETENTION_DAYS=365
BACKUP_KEEP=7
